# Entorno de Flask
FLASK_ENV=development
FLASK_DEBUG=True
PORT=5000

# Seguridad y JWT
SECRET_KEY=cambiar_esta_clave_secreta_en_produccion
JWT_SECRET_KEY=cambiar_esta_clave_jwt_secreta_en_produccion
JWT_ACCESS_TOKEN_EXPIRES=86400  # En segundos (24 horas)

# Base de Datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sitelog_db

# Carpeta para almacenamiento de evidencias fotográficas
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216  # 16 MB máximo
