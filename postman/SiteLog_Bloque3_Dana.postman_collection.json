						{
							"listen": "test",
							"script": {
								"exec": [
									"var response = JSON.parse(responseBody);",
									"var tokenVal = (response.data && response.data.token) ? response.data.token : response.token;",
									"pm.environment.set(\"token\", tokenVal);",
									"pm.collectionVariables.set(\"token\", tokenVal);"
								],
								"type": "text/javascript"
							}
