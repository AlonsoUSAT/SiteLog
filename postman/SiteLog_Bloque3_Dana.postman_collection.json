		{
			"name": "2. Módulo de Incidencias y Evidencias",
			"item": [
				{
					"name": "POST Registrar Incidencia Técnica (JSON)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"tipo_incidencia\": \"Interferencia de terceros\",\n    \"descripcion\": \"Red matriz de tubería de agua sin catastro interfiere con trazo de excavación en Sector B.\",\n    \"impacto_contractual\": \"Medio\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/asientos/1/incidencias",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"asientos",
								"1",
								"incidencias"
							]
						},
						"description": "Registra una incidencia técnica vinculada al Asiento #1. Rol mínimo: Residente."
					},
					"response": []
				},
				{
					"name": "POST Registrar Incidencia con Evidencia Fotográfica (multipart/form-data)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"body": {
							"mode": "formdata",
							"formdata": [
								{
									"key": "tipo_incidencia",
									"value": "Clima adverso",
									"type": "text"
								},
								{
									"key": "descripcion",
									"value": "Lluvias torrenciales atípicas anegan zanja de cimentación e impiden vaciado de concreto.",
									"type": "text"
								},
								{
									"key": "impacto_contractual",
									"value": "Alto",
									"type": "text"
								},
								{
									"key": "evidencia_foto",
									"type": "file",
									"src": []
								}
							]
						},
						"url": {
							"raw": "{{base_url}}/asientos/1/incidencias",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"asientos",
								"1",
								"incidencias"
							]
						},
						"description": "Registra incidencia técnica asociada a un asiento admitiendo la subida de evidencia fotográfica (multipart/form-data). Rol mínimo: Residente."
					},
					"response": []
				},
