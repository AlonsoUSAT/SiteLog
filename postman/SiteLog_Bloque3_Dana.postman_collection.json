							"mode": "raw",
							"raw": "{\n    \"observacion\": \"Supervisión verifica en campo la interferencia. Se solicita plano de replanteo y se autoriza ampliación de plazo preliminar.\",\n    \"impacto_contractual\": \"Crítico\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
