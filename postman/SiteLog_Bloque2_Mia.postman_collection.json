            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código HTTP 409\", function () { pm.response.to.have.status(409); });",
                  "var j = pm.response.json();",
                  "pm.test(\"success = false y mensaje de error\", function () { pm.expect(j.success).to.eql(false); pm.expect(j.error).to.be.a(\"string\"); });",
                  "pm.test(\"Devuelve el asiento original\", function(){ pm.expect(j.asiento.id).to.eql(parseInt(pm.collectionVariables.get(\"asiento_id\"))); });"
                ]
