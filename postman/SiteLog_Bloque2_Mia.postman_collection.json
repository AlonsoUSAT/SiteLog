            ],
            "url": {
              "raw": "{{base_url}}/asientos",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "asientos"
              ]
            },
            "description": "Crea una Consulta dentro del radio de 50 m. Guarda {{asiento_id}} y {{codigo_qr}}.",
            "body": {
              "mode": "raw",
              "raw": "{\n    \"id_obra\": \"{{id_obra}}\",\n    \"tipo\": \"Consulta\",\n    \"titulo\": \"Consulta sobre interferencia de red\",\n    \"descripcion\": \"Se halló tubería no contemplada en el expediente técnico.\",\n    \"lat_registro\": -6.77138,\n    \"lon_registro\": -79.84089,\n    \"uuid_operacion\": \"{{uuid_op}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"uuid_op\", pm.variables.replaceIn(\"{{$guid}}\"));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "var j = pm.response.json();",
                  "pm.test(\"success = true\", function () { pm.expect(j.success).to.eql(true); });",
                  "pm.test(\"Correlativo y QR generados\", function(){ pm.expect(j.asiento.numero_correlativo).to.be.a(\"number\"); pm.expect(j.asiento.codigo_qr_verificacion).to.include(\"SITELOG-\"); });",
                  "pm.collectionVariables.set(\"asiento_id\", j.asiento.id);",
                  "pm.collectionVariables.set(\"codigo_qr\", j.asiento.codigo_qr_verificacion);"
                ]
              }
            }
          ]
        },
