            "body": {
              "mode": "raw",
              "raw": "{\n    \"id_obra\": \"{{id_obra}}\",\n    \"tipo\": \"Consulta\",\n    \"titulo\": \"Consulta sobre interferencia de red\",\n    \"descripcion\": \"Se halló tubería no contemplada en el expediente técnico.\",\n    \"lat_registro\": -6.77138,\n    \"lon_registro\": -79.84089,\n    \"uuid_operacion\": \"{{uuid_op}}\"\n}",
