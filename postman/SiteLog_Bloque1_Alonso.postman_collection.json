		"name": "SiteLog - Bloque 1 (Alonso: Auth y Obras)",
		"description": "Colección de Postman para el Bloque 1 de SiteLog (Alonso: Autenticación JWT, FCM Token y Módulo de Obras).\nIncluye scripts de prueba automáticos y guardado automático del token JWT en variables de entorno.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Autenticación (Auth)",
			"item": [
				{
					"name": "POST Login - Residente",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Respuesta exitosa con token JWT\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.success).to.eql(true);",
									"    pm.expect(jsonData.token).to.be.a('string');",
									"    pm.expect(jsonData.rol).to.eql('Residente');",
									"    ",
									"    // Guardar automáticamente el token JWT para los siguientes endpoints",
									"    pm.collectionVariables.set(\"jwt_token\", jsonData.token);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"correo\": \"residente@sitelog.pe\",\n    \"password\": \"residente123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"login"
							]
						},
						"description": "Autentica al Residente y guarda automáticamente su token en la variable {{jwt_token}}."
					},
					"response": []
				},
